# ----------------------------------------------------------------- database
# Local Homebrew Postgres (OS user, no password):
DATABASE_URL=postgresql+psycopg://localhost:5432/rag_hardware
# Docker Compose sets its own URL (postgresql+psycopg://rag:rag@db:5432/rag_hardware).

# ---------------------------------------------------------------------- LLM
# gemini | extractive  (extractive = deterministic template answers, no API calls)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=2048
# LLM_THINKING_LEVEL=low         # optional, Gemini 3+: low | medium | high (gemini-3.8-flash rejects "minimal")
# LLM_THINKING_BUDGET=0          # optional, older models that use a token budget instead
# warn = keep LLM answer but flag ungrounded prices; fallback = replace with grounded extractive answer
GROUNDING_POLICY=fallback

# --------------------------------------------------------------- embeddings
# sentence_transformers | gemini | hashing (tests only)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the vector(N) column created by the migration.
EMBEDDING_DIMENSION=384
EMBEDDING_VERSION=1
EMBEDDING_BATCH_SIZE=64
# EMBEDDING_DEVICE=cpu           # cpu | mps | cuda (auto-detected when unset)

# ----------------------------------------------------------------- reranker
# cross_encoder | llm | passthrough
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=BAAI/bge-reranker-base

# ---------------------------------------------------------------- retrieval
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
HYBRID_TOP_K=20
RRF_K=60
VECTOR_WEIGHT=1.0
KEYWORD_WEIGHT=1.0
RERANK_CANDIDATES=20
FINAL_CONTEXT_K=5
RECOMMENDATION_CONTEXT_K=8
# Project questions also get the store catalog (up to N parts) to decide availability; 0 disables
PROJECT_INVENTORY_LIMIT=60
# Candidate kept if it matched lexically OR cosine similarity >= this
MIN_RETRIEVAL_SCORE=0.55
# Minimum reranker relevance probability (0..1) for a chunk to enter the context
MIN_RERANK_SCORE=0.05
HNSW_EF_SEARCH=64
HNSW_ITERATIVE_SCAN=relaxed_order
PRICE_APPROX_TOLERANCE=0.10

# ----------------------------------------------------------------- chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=75

# -------------------------------------------------------------------- cache
CACHE_TTL_SECONDS=600
CACHE_MAX_ITEMS=2048
# REDIS_URL=redis://localhost:6379/0   # optional; requires `pip install redis`

# ---------------------------------------------------------------------- app
LOG_LEVEL=INFO
LOG_JSON=true
# Comma-separated; empty disables API-key auth. Clients send header X-API-Key.
API_KEYS=
WARMUP_MODELS=false
DEFAULT_CURRENCY=EGP
DEFAULT_COUNTRY=Egypt
